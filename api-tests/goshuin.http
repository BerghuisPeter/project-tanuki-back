### Variables
@goshuin_service_url = http://localhost:8083

### Login with the test account (to get token for POST)
POST http://localhost:8081/api/v1/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123!"
}

> {%
    if (response.status === 200 && response.body) {
        client.global.set("access_token", response.body.accessToken);
        client.global.set("refresh_token", response.body.refreshToken);
    } else {
        client.log("Request failed or returned empty body. Status: " + response.status);
    }
%}

### Get all temples (Public)
GET {{goshuin_service_url}}/api/v1/temples
Accept: application/json

### Get all goshuins (Public)
GET {{goshuin_service_url}}/api/v1/goshuin
Accept: application/json

### Add a new temple (Senso-ji) (Protected)
POST {{goshuin_service_url}}/api/v1/temples
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "translations": {
    "ja": {
      "name": "浅草寺",
      "address": "東京都台東区浅草２丁目３−１",
      "description": "東京都内最古の寺院。聖観世音菩薩を本尊とする。"
    },
    "en": {
      "name": "Senso-ji",
      "address": "2-3-1 Asakusa, Taito City, Tokyo",
      "description": "Tokyo's oldest temple, dedicated to Kannon Bosatsu."
    }
  },
  "longitude": 139.7967,
  "latitude": 35.7148,
  "affiliation": "Buddhist",
  "websiteUrl": "https://www.senso-ji.jp/",
  "phoneNumber": "03-3842-0181",
  "goshuinType": "Write-in",
  "goshuinServiceOpenUntil": "16:00",
  "imageUrl": "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6d/Senso-ji_Kaminarimon_Night.jpg/1024px-Senso-ji_Kaminarimon_Night.jpg"
}

### Add another temple (Meiji Jingu - simplified) (Protected)
POST {{goshuin_service_url}}/api/v1/temples
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "translations": {
    "en": {
      "name": "Meiji Jingu",
      "address": "1-1 Yoyogikamizonocho, Shibuya City, Tokyo"
    }
  },
  "affiliation": "Shinto",
  "longitude": 139.6993,
  "latitude": 35.6764
}

### Add a new goshuin (Protected)
POST {{goshuin_service_url}}/api/v1/goshuin
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "format": "written",
  "templeId": "b981ec39-2381-47dc-a3fa-22f19f842c67",
  "pages": 1,
  "startDate": "2024-05-01",
  "endDate": "2024-05-31",
  "translations": {
    "en": {
      "label": "Spring Special Goshuin",
      "description": "Special goshuin for the cherry blossom season."
    },
    "ja": {
      "label": "春限定御朱印",
      "description": "桜の季節限定の御朱印です。"
    }
  },
  "images": [
    {
      "url": "https://example.com/goshuin/spring2024.jpg"
    }
  ]
}

### Add a new goshuin with images as objects (Protected)
POST {{goshuin_service_url}}/api/v1/goshuin
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "format": "written",
  "templeId": "b981ec39-2381-47dc-a3fa-22f19f842c67",
  "pages": 1,
  "startDate": "2024-05-01",
  "endDate": "2024-05-31",
  "translations": {
    "en": {
      "label": "Spring Special Goshuin",
      "description": "Special goshuin for the cherry blossom season."
    }
  },
  "images": [
    {
      "url": "https://example.com/goshuin/spring2024.jpg"
    }
  ]
}
