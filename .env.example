# General / Database Configuration
ENVIRONMENT=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tanuki-db
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=secret
SPRING_LIQUIBASE_ENABLED=true
JWT_SECRET=test-secret-key-that-needs-to-be-long-enough-to-be-secure-32-chars
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# Inter-Service URLs
AUTH_SERVICE_URL=http://localhost:8081
PROFILE_SERVICE_URL=http://localhost:8082
GOSHUIN_SERVICE_URL=http://localhost:8083
FRONT_URL=http://localhost:4200

# Auth & Google OAuth2
GOOGLE_CLIENT_ID=583627204016-5o809inoo1hs877478cqtthd15h0a3hn.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google

# Google Cloud Storage & Pub/Sub
GCP_PROJECT_ID=tanuki-dev
GCP_STORAGE_BUCKET_NAME=your_app_bucket_name
GCP_STORAGE_CREDENTIALS_JSON=
ENRICHMENT_TOPIC_NAME=enrichment-requests
# Set to use the local Pub/Sub emulator (docker compose up -d pubsub-emulator); leave empty to use real GCP
PUBSUB_EMULATOR_HOST=localhost:8681
# Where the emulator pushes messages (host worker by default; http://enrichment-worker:8080/enrich for the compose worker)
PUBSUB_PUSH_ENDPOINT=http://host.docker.internal:8085/enrich

# Enrichment Worker Configuration
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GEMINI_API_KEY=your-google-gemini-api-key
LOG_LEVEL=INFO
